      "name": "Authentication",
      "item": [
        {
          "name": "Sign In Tenant Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.accessToken) pm.collectionVariables.set('accessToken', json.data.accessToken);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const value = json.data && json.data.user && json.data.user.tenantId;",
                  "if (value) pm.collectionVariables.set('tenantId', value);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\",\n  \"rememberMe\": true\n}"
            },
            "url": "{{baseUrl}}/auth/login"
