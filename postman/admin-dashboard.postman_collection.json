            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"campaign\": \"Fresh basket booster\",\n  \"code\": \"FRESH15\",\n  \"discount\": \"15% off produce\",\n  \"startsAt\": \"2026-04-10T00:00:00.000Z\",\n  \"endsAt\": \"2026-05-11T00:00:00.000Z\",\n  \"status\": \"active\",\n  \"uses\": 86\n}"
            },
            "url": "{{baseUrl}}/admin/promotions"
          }
        },
        {
          "name": "Update Promotion",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "x-tenant-id", "value": "{{tenantId}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"campaign\": \"Fresh basket booster\",\n  \"code\": \"FRESH15\",\n  \"discount\": \"20% off produce\",\n  \"startsAt\": \"2026-04-10T00:00:00.000Z\",\n  \"endsAt\": \"2026-05-11T00:00:00.000Z\",\n  \"status\": \"active\",\n  \"uses\": 87\n}"
            },
            "url": "{{baseUrl}}/admin/promotions/{{promotionId}}"
          }
        },
        {
          "name": "Delete Promotion",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "x-tenant-id", "value": "{{tenantId}}" }],
            "url": "{{baseUrl}}/admin/promotions/{{promotionId}}"
          }
        }
      ]
    },
    {
      "name": "Delivery Fees",
      "item": [
        {
          "name": "List Delivery Fees",
          "request": {
            "method": "GET",
            "header": [{ "key": "x-tenant-id", "value": "{{tenantId}}" }],
            "url": "{{baseUrl}}/admin/delivery-fees?search=&region="
          }
        },
        {
          "name": "Create Delivery Fee",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('deliveryFeeId', json.data._id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "x-tenant-id", "value": "{{tenantId}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"region\": \"Yangon\",\n  \"township\": \"Kamayut\",\n  \"fee\": 2.5,\n  \"freeOver\": 50,\n  \"eta\": \"Same day\",\n  \"status\": \"active\"\n}"
            },
            "url": "{{baseUrl}}/admin/delivery-fees"
          }
        },
        {
          "name": "Update Delivery Fee",
          "request": {
