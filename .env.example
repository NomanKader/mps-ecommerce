NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
MONGODB_URI=mongodb://127.0.0.1:27017/mps-ecommerce
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=1d
JWT_REMEMBER_ME_EXPIRES_IN=30d
OTP_EXPIRES_IN_MINUTES=5
OTP_RESEND_DELAY_SECONDS=60
CORS_ORIGIN=http://localhost:3000
APP_NAME=MPS Ecommerce SaaS API
LOG_LEVEL=info
TENANT_HEADER_KEY=x-tenant-id
AWS_ACCESS_KEY_ID=replace-with-aws-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-aws-secret-access-key
AWS_REGION=ap-southeast-1
S3_BUCKET_NAME=replace-with-s3-bucket-name
S3_SIGNED_URL_EXPIRES_IN_SECONDS=3600
LOCAL_UPLOAD_DIR=uploads
LOCAL_UPLOAD_PUBLIC_PATH=/uploads
PUBLIC_BASE_URL=http://localhost:5000
